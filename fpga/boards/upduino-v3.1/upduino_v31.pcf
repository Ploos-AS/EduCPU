# UPduino v3.x RGB LED pins, verified against XarkLabs/upduino-example.
# On-board RGB LED uses negative logic on these dedicated pins.
set_io -nowarn led_g 39
set_io -nowarn led_r 41
set_io -nowarn led_b 40

# FTDI serial receive: USB host -> FPGA
set_io -nowarn serial_rxd 15

# FTDI serial transmit: FPGA -> USB host
set_io -nowarn serial_txd 14
